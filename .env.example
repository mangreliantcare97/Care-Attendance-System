# ---------------------------------------------------------------------------
# Care Attendance — Express + MongoDB
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Public base URL of the app (used for absolute links / cookie trust)
APP_URL=http://localhost:3000

# IANA timezone used to compute "today", month boundaries and working days.
# Calendar dates are stored as YYYY-MM-DD strings in this timezone.
APP_TIMEZONE=Europe/London

# MongoDB connection string — use a new database for this project.
MONGODB_URI=mongodb://127.0.0.1:27017/care-attendance

# Session cookie. SESSION_SECRET is required in every environment.
# Generate a new long random value for Care Attendance; never reuse the HRM
# secret. Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=care.sid
# Rolling session lifetime. Every request refreshes the window; an unused
# session expires after this many hours. The cookie is httpOnly, SameSite=Lax
# and Secure when NODE_ENV=production.
SESSION_MAX_HOURS=12

# Number of reverse proxies in front of the app (1 = Render/Heroku style)
TRUST_PROXY=1

# Login brute-force protection
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# Public check-in endpoints (per IP; an office shares one address, so the
# default budget is deliberately generous).
PUBLIC_RATE_LIMIT_WINDOW_MINUTES=15
PUBLIC_RATE_LIMIT_MAX=100

# Optional Cloudflare Turnstile on the public form. Leave empty to disable.
TURNSTILE_SECRET=

# Seed / bootstrap admin. The password is REQUIRED to seed an admin and is
# never hardcoded in the repository.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Mail (password reset)
# ---------------------------------------------------------------------------
# none       — no mails are sent (default)
# console    — the mail is printed to the server log (development)
# cloudflare — Cloudflare Email Service, REST API
MAIL_PROVIDER=none

# The sender: "name <address@example.com>" or just "address@example.com".
MAIL_FROM="Care Attendance <noreply@example.com>"

# Cloudflare Email Service (REST API) — only needed for MAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# The public address of the app. Password reset links and the public check-in
# links shown to administrators are built from it — never from request headers.
APP_BASE_URL=http://localhost:3000

# How long a password reset link is valid and how often it may be used.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=5
