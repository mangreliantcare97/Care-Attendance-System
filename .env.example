# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Europe/London

# MongoDB and sessions
MONGODB_URI=mongodb://127.0.0.1:27017/lean-hrm
SESSION_SECRET=
SESSION_COOKIE_NAME=hrm.sid
SESSION_TTL_MINUTES=480
TRUST_PROXY=1

# Working days and leave allowance
WORKING_WEEK=1,2,3,4,5
ANNUAL_ALLOWANCE_DEFAULT=28

# Login and password-reset limits
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=5

# Initial administrator (used by `npm run seed`)
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Password-reset email
MAIL_PROVIDER=none
MAIL_FROM=
BREVO_API_KEY=

# Optional alternative provider: Cloudflare Email Service
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
